{% set root = "../" %}

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Blog — Joseph Thomas</title>

  <meta
    name="description"
    content="Thoughts, experiments, lessons and observations from my journey as a product designer."
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@200;300;400;500;700;800;900&family=Sora:wght@200;300;400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/tokens.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/blog.css">

</head>

<body class="blog-page">

  {% include "components/nav.html" %}


  <main class="blog-container">




    <!-- =========================================
         BLOG HERO
    ========================================== -->

    <section class="blog-hero">

      <p class="blog-label">
        JOURNAL
      </p>

      <h1 class="blog-title">
        Thoughts, experiments & things I'm figuring out.
      </h1>

      <p class="blog-intro">
        Ideas, lessons, experiments and observations from my journey through design, technology and everything in between.
      </p>

    </section>


<!-- =========================================
     FEATURED ARTICLE
========================================== -->

{% set featured = collections.posts | first %}

<section class="blog-featured">

  <div class="blog-featured-card">

  <a
    href="{{ featured.url }}"
    class="blog-featured-link"
    aria-label="Read {{ featured.data.title }}"
  ></a>

    {% if featured.data.image %}

      <img
        src="{{ featured.data.image }}"
        alt="{{ featured.data.title }}"
        class="blog-featured-image"
      >

    {% endif %}

    <div class="blog-featured-content">

      <div class="blog-card-meta">
        {{ featured.data.category }} · {{ featured.data.readTime }}
      </div>

      <h2 class="blog-featured-title">
        {{ featured.data.title }}
      </h2>

      <p class="blog-featured-description">
        {{ featured.data.description }}
      </p>

     <span class="blog-read-more">
  Read article →
</span>

    </div>

  </div>

</section>

    <!-- =========================================
         ALL ARTICLES
    ========================================== -->

    <section class="blog-articles">

      <h2 class="blog-section-title">
        All articles
      </h2>


      <div class="blog-grid">

        {% for post in collections.posts %}

  {% if post != featured %}

    <a href="{{ post.url }}" class="blog-card">


            {% if post.data.image %}

              <img
                src="{{ post.data.image }}"
                alt="{{ post.data.title }}"
                class="blog-card-image"
              >

            {% endif %}


            <div class="blog-card-meta">
              {{ post.data.category }} · {{ post.data.readTime }}
            </div>


            <h3 class="blog-card-title">
              {{ post.data.title }}
            </h3>


            <p class="blog-card-description">
              {{ post.data.description }}
            </p>


             </a>

  {% endif %}

{% endfor %}

      </div>

    </section>


  </main>


  {% include "components/footer.html" %}


  <script src="/script.js" defer></script>

</body>

</html>