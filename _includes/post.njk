<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} — Joseph Thomas</title>

  <meta
    name="description"
    content="{{ description }}"
  >

    <!-- LinkedIn / Social Preview -->
  <meta property="og:title" content="{{ title }} — Joseph Thomas">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://josephthomas.online{{ image }}">
  <meta property="og:url" content="https://josephthomas.online{{ page.url }}">
  <meta property="og:type" content="article">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} — Joseph Thomas">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://josephthomas.online{{ image }}">


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@200;300;400;500;700;800;900&family=Sora:wght@200;300;400;500;600;700;800;900&display=swap"
  rel="stylesheet"
>


  <link rel="stylesheet" href="/tokens.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/blog.css">
</head>

<body class="blog-page">

  {% set root = "../../../" %}
  {% include "components/nav.html" %}

  <main class="blog-post">

    <header class="blog-post-header">

      <div class="blog-post-meta">
        <span>{{ category }}</span>
        <span>·</span>
        <span>{{ readTime }}</span>
        <span>·</span>
        <span>{{ date | readableDate }}</span>
      </div>

      <h1>{{ title }}</h1>

      <p class="blog-post-description">
        {{ description }}
      </p>

    </header>

    {% if image %}
      <div class="blog-post-image">
        <img src="{{ image }}" alt="">
      </div>
    {% endif %}

    <article class="blog-post-content">
      {{ content | safe }}
    </article>

  </main>

  {% include "components/footer.html" %}

  <script src="/script.js" defer></script>

</body>
</html>